---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us - TubeToMP4">
  <Header />

  <main class="flex-grow pt-32 pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold text-white mb-8">Contact Us</h1>

      <p class="text-white/60 leading-relaxed mb-8">
        We'd love to hear from you. Whether you have a question about our service, need technical support, or want to report an issue, we're here to help.
      </p>

      <div class="grid gap-8 md:grid-cols-2 mb-12">
        <!-- General Inquiries -->
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-brand-red to-red-600 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2">General Inquiries</h2>
          <p class="text-white/60 text-sm mb-4">
            For general questions about our service, features, or how to use TubeToMP4.
          </p>
          <a href="mailto:contact@tubetomp4.online" class="text-brand-red hover:underline text-sm">
            contact@tubetomp4.online
          </a>
        </div>

        <!-- Technical Support -->
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-brand-red to-red-600 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2">Technical Support</h2>
          <p class="text-white/60 text-sm mb-4">
            Experiencing issues with downloads or conversions? Our technical team is ready to help.
          </p>
          <a href="mailto:support@tubetomp4.online" class="text-brand-red hover:underline text-sm">
            support@tubetomp4.online
          </a>
        </div>

        <!-- DMCA/Copyright -->
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-brand-red to-red-600 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.249-8.25-3.286zm0 13.036h.008v.008H12v-.008z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2">DMCA / Copyright</h2>
          <p class="text-white/60 text-sm mb-4">
            For copyright infringement notices or DMCA-related inquiries.
          </p>
          <a href="mailto:dmca@tubetomp4.online" class="text-brand-red hover:underline text-sm">
            dmca@tubetomp4.online
          </a>
        </div>

        <!-- Business Inquiries -->
        <div class="bg-white/5 rounded-xl p-6 border border-white/10">
          <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-brand-red to-red-600 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-white">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2">Business Inquiries</h2>
          <p class="text-white/60 text-sm mb-4">
            For partnership opportunities, advertising, or business-related matters.
          </p>
          <a href="mailto:business@tubetomp4.online" class="text-brand-red hover:underline text-sm">
            business@tubetomp4.online
          </a>
        </div>
      </div>

      <!-- Response Time -->
      <div class="bg-white/5 rounded-xl p-6 border border-white/10 mb-8">
        <h2 class="text-xl font-bold text-white mb-4">Response Time</h2>
        <p class="text-white/60 leading-relaxed">
          We strive to respond to all inquiries within 24-48 business hours. For urgent matters, please include "URGENT" in your email subject line. Please note that response times may vary during weekends and holidays.
        </p>
      </div>

      <!-- Before Contacting -->
      <div class="bg-white/5 rounded-xl p-6 border border-white/10">
        <h2 class="text-xl font-bold text-white mb-4">Before Contacting Us</h2>
        <p class="text-white/60 leading-relaxed mb-4">
          Many common questions are answered in our resources:
        </p>
        <ul class="space-y-3">
          <li>
            <a href="/faq" class="text-brand-red hover:underline flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
              Frequently Asked Questions (FAQ)
            </a>
          </li>
          <li>
            <a href="/terms" class="text-brand-red hover:underline flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
              Terms of Service
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-brand-red hover:underline flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/dmca" class="text-brand-red hover:underline flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
              DMCA Policy
            </a>
          </li>
        </ul>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
