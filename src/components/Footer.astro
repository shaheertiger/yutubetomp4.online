---
import { getLangFromUrl, useTranslations } from "../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-dark border-t border-white/5 pt-16 pb-8 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <!-- Brand Section -->
      <div class="space-y-6">
        <div class="flex items-center gap-2">
          <div
            class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-red to-red-600 flex items-center justify-center shadow-lg shadow-brand-red/20"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 text-white"
            >
              <path
                d="M4.5 4.5a3 3 0 00-3 3v9a3 3 0 003 3h8.25a3 3 0 003-3v-9a3 3 0 00-3-3H4.5zM19.94 18.75l-2.69-2.69V7.94l2.69-2.69c.944-.945 2.56-.276 2.56 1.06v11.38c0 1.336-1.616 2.005-2.56 1.06z"
              ></path>
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight text-white">
            Tube<span class="text-brand-red">ToMP4</span>
          </span>
        </div>
        <p class="text-white/50 text-sm leading-relaxed max-w-xs">
          {t("footer.disclaimer.text")}
        </p>
      </div>

      <!-- Pages -->
      <div class="space-y-6">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">
          {t("footer.pages")}
        </h3>
        <ul class="space-y-3">
          <li>
            <a
              href={lang === "en" ? "/" : `/${lang}`}
              class="text-white/50 hover:text-white transition-colors text-sm"
              >{t("nav.home")}</a>
          </li>
          <li>
            <a
              href={lang === "en"
                ? "/youtube-to-mp4"
                : `/${lang}/youtube-to-mp4`}
              class="text-white/50 hover:text-white transition-colors text-sm"
              >{t("nav.mp4_guide")}</a>
          </li>
          <li>
            <a
              href={lang === "en"
                ? "/youtube-to-mp3"
                : `/${lang}/youtube-to-mp3`}
              class="text-white/50 hover:text-white transition-colors text-sm"
              >{t("nav.mp3")}</a>
          </li>
          <li>
            <a
              href={lang === "en" ? "/faq" : `/${lang}/faq`}
              class="text-white/50 hover:text-white transition-colors text-sm"
              >{t("nav.faq")}</a>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div class="space-y-6">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">
          {t("footer.legal")}
        </h3>
        <ul class="space-y-3">
          <li>
            <a
              href={lang === "en" ? "/terms" : `/${lang}/terms`}
              class="text-white/50 hover:text-white transition-colors text-sm"
              >{t("footer.terms")}</a>
          </li>
          <li>
            <a
              href={lang === "en" ? "/privacy" : `/${lang}/privacy`}
              class="text-white/50 hover:text-white transition-colors text-sm"
              >{t("footer.privacy")}</a>
          </li>
          <li>
            <a
              href={lang === "en" ? "/dmca" : `/${lang}/dmca`}
              class="text-white/50 hover:text-white transition-colors text-sm"
              >{t("footer.dmca")}</a>
          </li>
          <li>
            <a
              href={lang === "en" ? "/contact" : `/${lang}/contact`}
              class="text-white/50 hover:text-white transition-colors text-sm"
              >{t("footer.contact")}</a>
          </li>
        </ul>
      </div>

      <!-- Disclaimer -->
      <div class="space-y-6">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">
          {t("footer.disclaimer")}
        </h3>
        <p class="text-white/40 text-xs leading-relaxed">
          {t("footer.disclaimer.text")}
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4"
    >
      <p class="text-white/40 text-sm">
        &copy; {currentYear} TubeToMP4. {t("footer.copyright")}
      </p>
      <div class="flex items-center space-x-6">
        <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors">
          <span class="sr-only">X (Twitter)</span>
          <svg
            class="h-5 w-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
        </a>
        <a href="https://github.com/shaheertiger/yutubetomp4.online" target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors">
          <span class="sr-only">GitHub</span>
          <svg
            class="h-5 w-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
